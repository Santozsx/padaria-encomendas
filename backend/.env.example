# Copie para .env e preencha. NUNCA versione o arquivo .env.

# Porta HTTP da API (o mesmo servidor também entrega as telas web)
PORT=3000
NODE_ENV=development

# Supabase > Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# chave pública (vai para o navegador — usada só para login da equipe e Realtime)
SUPABASE_ANON_KEY=eyJ...
# chave secreta (SÓ no servidor — ignora RLS). Nunca coloque no front-end.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Origens extras liberadas no CORS (separadas por vírgula).
# As origens do app Capacitor (http://localhost, capacitor://localhost) já são liberadas.
CORS_ORIGINS=http://localhost:3000

# Se a API estiver atrás de proxy (Render, Railway, Nginx), use 1
TRUST_PROXY=0

# ---------------------------------------------------------------------
# SaaS: endereço público e cobrança das licenças (Asaas)
# ---------------------------------------------------------------------
# Endereço do sistema na internet (sem barra no final). Ex.: https://app.suapadaria.com.br
PUBLIC_URL=

# Chave de API da SUA conta Asaas (Integrações > Chaves de API).
# Vazio = cobrança automática desligada (você libera as lojas no Painel).
ASAAS_API_KEY=
# sandbox = testes (dinheiro de mentira) | production = cobrança real
ASAAS_ENV=sandbox
# Token que você inventa e cadastra no webhook do Asaas (Integrações > Webhooks)
ASAAS_WEBHOOK_TOKEN=
